<!DOCTYPE html>
<html lang="en">

<head>
</head>

<body>

    <table border="1">

        <tr>
            <td>Name</td>
            <td>Age</td>
            <td>Email</td>
            <td>Operation</td>
        </tr>

        <% result.forEach(student => { %>

        <tr>

            <td><%= student.name %></td>

            <td><%= student.age %></td>

            <td><%= student.email %></td>

            <td>

                <a href="/ui/student/<%= student._id %>">
                    Update
                </a>

                <a href="#" onclick="deleteStudent('<%= student._id %>')">
                    Delete
                </a>

            </td>

        </tr>

        <% }) %>

    </table>


    <script>

        function deleteStudent(id) {

            fetch("/delete/" + id, {
                method: "DELETE"
            })

            .then(response => response.json())

            .then(result => {

                if (result.success) {

                    location.reload();

                } else {

                    alert(result.message);

                }

            });

        }

    </script>

</body>

</html>