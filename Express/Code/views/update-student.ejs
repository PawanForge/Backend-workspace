<!DOCTYPE html>
<html lang="en">

<head>
</head>

<body>

    <h2>Update Student</h2>

    <form action="/update-student/<%= result._id %>" method="POST">

        <input
            type="text"
            name="name"
            value="<%= result.name %>"
        >

        <br><br>

        <input
            type="number"
            name="age"
            value="<%= result.age %>"
        >

        <br><br>

        <input
            type="email"
            name="email"
            value="<%= result.email %>"
        >

        <br><br>

        <button type="submit">
            Update
        </button>

    </form>

</body>

</html>1